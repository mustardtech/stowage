{{/*
  Common labels and selectors. Each component has its own selector but
  shares the chart-managed `app.kubernetes.io/part-of` so cluster tooling
  (Service mesh, dashboards) can scope a query to "everything stowage".
*/}}
{{- define "stowage.commonLabels" -}}
app.kubernetes.io/part-of: stowage
app.kubernetes.io/managed-by: {{ .Release.Service | default "Helm" }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" }}
{{- end -}}

{{- define "stowage.dashboardLabels" -}}
{{ include "stowage.commonLabels" . }}
app.kubernetes.io/name: stowage
app.kubernetes.io/component: dashboard
{{- end -}}

{{- define "stowage.dashboardSelector" -}}
app.kubernetes.io/name: stowage
app.kubernetes.io/component: dashboard
{{- end -}}

{{/*
  In-cluster URL the operator stamps into every consumer Secret as
  AWS_ENDPOINT_URL. Points at the stowage Service on the embedded proxy
  port (s3_proxy.listen :8090).
*/}}
{{- define "stowage.proxyEndpointURL" -}}
http://stowage.{{ .Release.Namespace }}.svc.cluster.local:8090
{{- end -}}

{{/*
  imagePullSecrets renders the Pod-spec field. Names existing Secrets in
  .Release.Namespace; the chart does not create dockerconfigjson Secrets.
  Emits nothing when the list is empty.
*/}}
{{- define "stowage.imagePullSecrets" -}}
{{- with .Values.image.pullSecrets -}}
imagePullSecrets:
{{- range . }}
  - name: {{ . }}
{{- end }}
{{- end -}}
{{- end -}}

{{/*
  secretKey resolves the AES-256 root key used to seal at-rest secrets.
  Resolution order:
   1. Explicit .Values.secretKey
   2. Existing chart-managed Secret in the cluster (helm upgrade reuses it)
   3. Freshly generated key (sha256 of 64 random alphanum chars; 64 hex
      chars, which secrets.New parses as 32 bytes)
*/}}
{{- define "stowage.secretKey" -}}
{{- if .Values.secretKey -}}
{{ .Values.secretKey }}
{{- else -}}
{{- if not (hasKey .Values "_secretKeyCache") -}}
  {{- $existing := lookup "v1" "Secret" .Release.Namespace "stowage-secret-key" -}}
  {{- $key := "" -}}
  {{- if and $existing (hasKey (default (dict) $existing.data) "STOWAGE_SECRET_KEY") -}}
    {{- $key = (index $existing.data "STOWAGE_SECRET_KEY" | b64dec) -}}
  {{- else -}}
    {{- $key = randAlphaNum 64 | sha256sum -}}
  {{- end -}}
  {{- $_ := set .Values "_secretKeyCache" $key -}}
{{- end -}}
{{ .Values._secretKeyCache }}
{{- end -}}
{{- end -}}

{{/*
  webhookCert returns a dict with keys caCrt, tlsCrt, tlsKey (all base64-
  encoded PEM) for the chart-managed self-signed mode. The result is
  memoized on .Values._webhookCertCache so repeat calls across template
  files see the same cert. Resolution order:
   1. Cached dict on .Values._webhookCertCache
   2. Existing Secret (so `helm upgrade` doesn't rotate the cert)
   3. Freshly generated CA + server cert
*/}}
{{- define "stowage.webhookCert" -}}
{{- if not (hasKey .Values "_webhookCertCache") -}}
  {{- $cache := dict -}}
  {{- $svc := printf "stowage.%s.svc" .Release.Namespace -}}
  {{- $opSvc := printf "stowage-operator.%s.svc" .Release.Namespace -}}
  {{/* Both Service names, whatever the mode: "stowage" serves the webhook in
       single mode, "stowage-operator" in split mode, and a cert that covers
       both survives switching. webhookCertSANs tags the Secret so an older
       cert without the operator name is regenerated on upgrade. */}}
  {{- $altNames := list
      (printf "stowage.%s" .Release.Namespace)
      $svc
      (printf "%s.cluster.local" $svc)
      (printf "stowage-operator.%s" .Release.Namespace)
      $opSvc
      (printf "%s.cluster.local" $opSvc) -}}
  {{- $existing := lookup "v1" "Secret" .Release.Namespace "stowage-webhook-cert" -}}
  {{- $existingSANs := "" -}}
  {{- if $existing -}}{{- $existingSANs = index (default (dict) $existing.metadata.annotations) "stowage.io/webhook-cert-sans" | default "" -}}{{- end -}}
  {{- if and $existing (eq $existingSANs (include "stowage.webhookCertSANs" .)) (hasKey (default (dict) $existing.data) "tls.crt") (hasKey (default (dict) $existing.data) "ca.crt") -}}
    {{- $cache = dict
        "caCrt"  (index $existing.data "ca.crt")
        "tlsCrt" (index $existing.data "tls.crt")
        "tlsKey" (index $existing.data "tls.key") -}}
  {{- else -}}
    {{- $days := int .Values.webhook.selfSigned.validityDays -}}
    {{- $ca := genCA "stowage-webhook-ca" $days -}}
    {{- $cert := genSignedCert $svc nil $altNames $days $ca -}}
    {{- $cache = dict
        "caCrt"  ($ca.Cert | b64enc)
        "tlsCrt" ($cert.Cert | b64enc)
        "tlsKey" ($cert.Key  | b64enc) -}}
  {{- end -}}
  {{- $_ := set .Values "_webhookCertCache" $cache -}}
{{- end -}}
{{- .Values._webhookCertCache | toJson -}}
{{- end -}}

{{/*
  webhookCABundle resolves the CA bundle stamped into the
  ValidatingWebhookConfiguration. Precedence:
   1. selfSigned.enabled — bundle generated by webhookCert
   2. explicit webhook.caBundle
   3. "" (cert-manager annotation path will inject it)
*/}}
{{- define "stowage.webhookCABundle" -}}
{{- if .Values.webhook.selfSigned.enabled -}}
{{- $cert := fromJson (include "stowage.webhookCert" .) -}}
{{ $cert.caCrt }}
{{- else -}}
{{ .Values.webhook.caBundle }}
{{- end -}}
{{- end -}}

{{/*
  Component labels/selectors. In single mode the one Deployment is the
  "dashboard" component (every role inside); in split mode there are
  three: dashboard, proxy, operator. The Deployment named "stowage" keeps
  the dashboard selector in both modes so an upgrade never has to replace
  it (selectors are immutable).
*/}}
{{- define "stowage.componentLabels" -}}
{{ include "stowage.commonLabels" .root }}
app.kubernetes.io/name: stowage
app.kubernetes.io/component: {{ .component }}
{{- end -}}

{{- define "stowage.componentSelector" -}}
app.kubernetes.io/name: stowage
app.kubernetes.io/component: {{ .component }}
{{- end -}}

{{/*
  Service names per mode. The S3 Service is always "stowage" so the
  AWS_ENDPOINT_URL stamped into consumer Secrets (stowage.proxyEndpointURL)
  never changes when a deployment moves from single to split.
*/}}
{{- define "stowage.dashboardServiceName" -}}
{{- if .Values.split.enabled }}stowage-dashboard{{ else }}stowage{{ end -}}
{{- end -}}

{{- define "stowage.webhookServiceName" -}}
{{- if .Values.split.enabled }}stowage-operator{{ else }}stowage{{ end -}}
{{- end -}}

{{/*
  Pod template shared by every Deployment. Args: root, role (dashboard |
  proxy | operator | all), component (label value). "all" is the single
  Pod and renders no STOWAGE_ROLES so the binary runs every enabled role.
*/}}
{{- define "stowage.podTemplate" -}}
{{- $ := .root -}}
{{- $role := .role -}}
{{- $hasOperator := or (eq $role "all") (eq $role "operator") -}}
{{- $hasProxy := or (eq $role "all") (eq $role "proxy") -}}
{{- $webhook := and $.Values.operator.enabled $.Values.webhook.enabled $hasOperator -}}
{{- $sqliteVolume := and (ne $.Values.db.driver "postgres") (eq $role "all") -}}
metadata:
  labels:
    {{- include "stowage.componentLabels" (dict "root" $ "component" .component) | nindent 4 }}
  annotations:
    # Roll the Pod when the rendered config or sealing key changes.
    checksum/config: {{ include (print $.Template.BasePath "/stowage-config.yaml") $ | sha256sum }}
    checksum/secret-key: {{ include "stowage.secretKey" $ | sha256sum }}
    {{- if $webhook }}
    checksum/webhook-cert: {{ include "stowage.webhookCABundle" $ | sha256sum }}
    {{- end }}
    {{- if $.Values.metrics.prometheusScrape }}
    prometheus.io/scrape: "true"
    prometheus.io/port: "8080"
    prometheus.io/path: "/metrics"
    {{- end }}
spec:
  serviceAccountName: stowage
  {{- with (include "stowage.imagePullSecrets" $ | trim) }}
  {{ . | nindent 2 }}
  {{- end }}
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    runAsGroup: 65532
    # fsGroup makes Secret volumes group-readable by 65532 so the
    # non-root container can read tls.crt / tls.key at 0440.
    fsGroup: 65532
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: stowage
      image: "{{ $.Values.image.registry }}/stowage:{{ $.Values.image.tag }}"
      imagePullPolicy: {{ $.Values.image.pullPolicy }}
      args:
        - serve
        - --config=/etc/stowage/config.yaml
      env:
        {{- if ne $role "all" }}
        - name: STOWAGE_ROLES
          value: {{ $role | quote }}
        {{- end }}
        - name: STOWAGE_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: stowage-secret-key
              key: STOWAGE_SECRET_KEY
        {{- if eq $.Values.db.driver "postgres" }}
        - name: STOWAGE_POSTGRES_DSN
          valueFrom:
            secretKeyRef:
              name: {{ required "db.postgres.existingSecret is required when db.driver is postgres" $.Values.db.postgres.existingSecret }}
              key: {{ $.Values.db.postgres.dsnKey }}
        {{- end }}
      ports:
        - name: http
          containerPort: 8080
        {{- if $hasProxy }}
        - name: s3
          containerPort: 8090
        {{- end }}
        {{- if $webhook }}
        - name: webhook
          containerPort: 9443
        {{- end }}
      volumeMounts:
        - name: config
          mountPath: /etc/stowage
          readOnly: true
        {{- if $sqliteVolume }}
        - name: data
          mountPath: /data
        {{- end }}
        {{- if $webhook }}
        - name: webhook-certs
          mountPath: /etc/stowage/webhook/certs
          readOnly: true
        {{- end }}
      livenessProbe:
        httpGet: {path: /healthz, port: http}
        initialDelaySeconds: 5
        periodSeconds: 10
      readinessProbe:
        httpGet: {path: /readyz, port: http}
        initialDelaySeconds: 2
        periodSeconds: 5
      resources:
        {{- toYaml .resources | nindent 8 }}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: [ALL]}
  volumes:
    - name: config
      configMap:
        name: stowage-config
    {{- if $sqliteVolume }}
    - name: data
      persistentVolumeClaim:
        claimName: stowage-data
    {{- end }}
    {{- if $webhook }}
    - name: webhook-certs
      secret:
        secretName: stowage-webhook-cert
        defaultMode: 0440
    {{- end }}
{{- end -}}

{{/*
  webhookCertSANs names the set of Service names the self-signed webhook
  cert covers. Stamped on the Secret; a mismatch regenerates the cert.
*/}}
{{- define "stowage.webhookCertSANs" -}}
stowage,stowage-operator
{{- end -}}
